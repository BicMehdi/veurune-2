{"event_id":"EVT-0720-0002","save_id":"VEY-0720","parent_save_id":"VEY-0719R","turn":710,"event_time":{"year":347,"day":513,"clock":"01:25"},"record_time":"2026-08-12T15:00:18.378Z","event_type":"bridge_contact_demands_specific_accusation","actor":"bridge_contact","target":"Mehdi","exact_dialogue":["Laquelle de mes actions ?","Tu as éventré des relais, laissé des hommes derrière toi et traversé Valdorne avec mon nom à la bouche.","Si tu veux une réponse, cesse de me faire deviner ton accusation."],"facts":{"identity_confirmed":false,"identity_denied":false,"hostile_action_started":false},"witnesses":["Mehdi"],"permanence":"recorded_dialogue"}
