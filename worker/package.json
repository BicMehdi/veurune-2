{
	"name": "veyrune-cloud-save",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types wrangler-generated.d.ts",
		"pretest": "npm run cf-typegen",
		"type-check": "tsc --noEmit",
		"test": "node --test test/*.test.mjs && node --experimental-strip-types --test test/*.test.ts && npm run type-check"
	},
	"dependencies": {
		"@cloudflare/codemode": "^0.5.1",
		"@cloudflare/workers-oauth-provider": "^0.8.1",
		"@modelcontextprotocol/sdk": "1.30.0",
		"@modelcontextprotocol/server": "2.0.0",
		"agents": "^0.20.1",
		"hono": "^4.12.27",
		"just-pick": "^4.2.0",
		"octokit": "^5.0.5",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"typescript": "6.0.3",
		"wrangler": "^4.105.0"
	},
	"engines": {
		"node": ">=22"
	},
	"overrides": {
		"@hono/node-server": "^2.0.5"
	}
}
